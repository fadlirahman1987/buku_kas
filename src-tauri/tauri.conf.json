{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buku Kas Pribadi",
  "version": "1.0.0",
  "identifier": "com.bukukas.pribadi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Buku Kas Pribadi",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Buku kas pribadi offline",
    "longDescription": "Catat uang masuk dan uang keluar pribadi secara offline, dengan autosave ke folder dan laporan siap cetak.",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
